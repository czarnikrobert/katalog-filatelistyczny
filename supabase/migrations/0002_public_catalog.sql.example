-- OPCJONALNIE: udostępnienie katalogu ogólnego publicznie (tylko odczyt).
-- Zmień rozszerzenie na .sql i uruchom, jeśli katalog ma być widoczny bez logowania.
-- Tabele kolekcji (specimens, valuations, storage_locations) pozostają prywatne.
-- Zdjęcia katalogowe wymagałyby osobnego, publicznego bucketu — skany egzemplarzy zostają prywatne.

create policy "countries: publiczny odczyt" on public.countries for select to anon using (true);
create policy "themes: publiczny odczyt" on public.themes for select to anon using (true);
create policy "series: publiczny odczyt" on public.series for select to anon using (true);
create policy "stamps: publiczny odczyt" on public.stamps for select to anon using (true);
create policy "stamp_catalog_numbers: publiczny odczyt" on public.stamp_catalog_numbers for select to anon using (true);
